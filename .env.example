DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=your-secret-key-here

# Supabase (remote) PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-supabase-db-password
POSTGRES_HOST=db.your-project-ref.supabase.co
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require

GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Social Auth Production settings (set on Render/Railway)
SOCIAL_AUTH_REDIRECT_IS_HTTPS=True
SOCIAL_AUTH_GOOGLE_OAUTH2_CALLBACK_URL=https://your-backend.onrender.com/social/complete/google-oauth2/

# Cloudinary Production Storage Settings
# Provide either the direct CLOUDINARY_URL connection string:
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# Or individual parameters:
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret




