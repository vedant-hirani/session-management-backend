{
  "info": {
    "name": "Sessions Marketplace API",
    "_postman_id": "sessions-marketplace-v2",
    "description": "Full API collection with auto token management.\n\n**HOW TO USE:**\n1. Import this collection\n2. Run '🔑 Get Creator Token' first — tokens auto-save\n3. Run '🔑 Get User Token' second\n4. All other requests use tokens automatically\n\n**Test Accounts (Supabase Remote DB):**\n- Creator: username=creator1 / password=creator123\n- User:    username=testuser / password=user123\n- Admin:   username=admin    / password=admin123\n\n**Environments:**\n- Local dev: base_url = http://127.0.0.1:8000\n- Render:    base_url = https://your-app.onrender.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",        "value": "http://127.0.0.1:8000", "type": "string" },
    { "key": "creator_access",  "value": "", "type": "string" },
    { "key": "creator_refresh", "value": "", "type": "string" },
    { "key": "user_access",     "value": "", "type": "string" },
    { "key": "user_refresh",    "value": "", "type": "string" },
    { "key": "session_id",      "value": "2", "type": "string" },
    { "key": "booking_id",      "value": "2", "type": "string" }
  ],
  "item": [
    {
      "name": "🔑 Step 1 — Get Tokens (Run These First)",
      "item": [
        {
          "name": "Get Creator Token",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var j = pm.response.json();",
                "pm.collectionVariables.set('creator_access',  j.access);",
                "pm.collectionVariables.set('creator_refresh', j.refresh);",
                "pm.test('Creator token saved', () => pm.response.to.have.status(200));",
                "console.log('✅ Creator token saved automatically');"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"creator1\",\n  \"password\": \"creator123\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/token/", "host": ["{{base_url}}"], "path": ["api","v1","auth","token",""] },
            "description": "Gets JWT for creator@test.com. Token auto-saved to collection variables."
          }
        },
        {
          "name": "Get User Token",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var j = pm.response.json();",
                "pm.collectionVariables.set('user_access',  j.access);",
                "pm.collectionVariables.set('user_refresh', j.refresh);",
                "pm.test('User token saved', () => pm.response.to.have.status(200));",
                "console.log('✅ User token saved automatically');"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"user123\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/token/", "host": ["{{base_url}}"], "path": ["api","v1","auth","token",""] },
            "description": "Gets JWT for user@test.com. Token auto-saved to collection variables."
          }
        },
        {
          "name": "Refresh Creator Access Token",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var j = pm.response.json();",
                "if(j.access) { pm.collectionVariables.set('creator_access', j.access); }",
                "pm.test('Token refreshed', () => pm.response.to.have.status(200));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refresh\": \"{{creator_refresh}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/token/refresh/", "host": ["{{base_url}}"], "path": ["api","v1","auth","token","refresh",""] }
          }
        },
        {
          "name": "Refresh User Access Token",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var j = pm.response.json();",
                "if(j.access) { pm.collectionVariables.set('user_access', j.access); }",
                "pm.test('Token refreshed', () => pm.response.to.have.status(200));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refresh\": \"{{user_refresh}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/token/refresh/", "host": ["{{base_url}}"], "path": ["api","v1","auth","token","refresh",""] }
          }
        }
      ]
    },
