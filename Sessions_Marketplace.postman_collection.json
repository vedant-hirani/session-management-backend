            "body": {"mode":"raw","raw":"{\n  \"first_name\": \"Creator\",\n  \"last_name\": \"One\",\n  \"bio\": \"I teach yoga, coding, and music.\",\n  \"avatar\": \"https://i.pravatar.cc/150?u=creator\"\n}"},
            "url": {"raw":"{{base_url}}/api/v1/auth/profile/","host":["{{base_url}}"],"path":["api","v1","auth","profile",""]}
          }
        },
        {
          "name": "Switch Role → Creator",
          "event": [{"listen":"test","script":{"exec":["var j=pm.response.json();","if(j.access){pm.collectionVariables.set('user_access',j.access);}","if(j.refresh){pm.collectionVariables.set('user_refresh',j.refresh);}","pm.test('Status 200',()=>pm.response.to.have.status(200));","pm.test('Role is creator',()=>pm.expect(j.role).to.eql('creator'));"],"type":"text/javascript"}}],
          "request": {
            "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{user_access}}","type":"string"}]},
            "method": "POST",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {"mode":"raw","raw":"{\n  \"role\": \"creator\"\n}"},
            "url": {"raw":"{{base_url}}/api/v1/auth/profile/role/","host":["{{base_url}}"],"path":["api","v1","auth","profile","role",""]}
          }
        },
        {
          "name": "Switch Role → User (revert)",
          "event": [{"listen":"test","script":{"exec":["var j=pm.response.json();","if(j.access){pm.collectionVariables.set('user_access',j.access);}","if(j.refresh){pm.collectionVariables.set('user_refresh',j.refresh);}","pm.test('Status 200',()=>pm.response.to.have.status(200));","pm.test('Role reverted',()=>pm.expect(j.role).to.eql('user'));"],"type":"text/javascript"}}],
          "request": {
            "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{user_access}}","type":"string"}]},
            "method": "POST",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {"mode":"raw","raw":"{\n  \"role\": \"user\"\n}"},
            "url": {"raw":"{{base_url}}/api/v1/auth/profile/role/","host":["{{base_url}}"],"path":["api","v1","auth","profile","role",""]}
          }
        },
        {
          "name": "Logout",
          "event": [{"listen":"test","script":{"exec":["pm.test('Status 200',()=>pm.response.to.have.status(200));"],"type":"text/javascript"}}],
          "request": {
            "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{user_access}}","type":"string"}]},
            "method": "POST",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {"mode":"raw","raw":"{\n  \"refresh\": \"{{user_refresh}}\"\n}"},
            "url": {"raw":"{{base_url}}/api/v1/auth/logout/","host":["{{base_url}}"],"path":["api","v1","auth","logout",""]}
          }
        }
      ]
    },
